# ==============================================================================
# JON — LOCAL-FIRST HYBRID AI ASSISTANT ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Cloud API Keys (Required for Online Cloud Gateway routing)
# ------------------------------------------------------------------------------
# Groq API key (for Chat / Research / Planning)
GROQ_API_KEY=your_groq_api_key_here

# Nvidia NIM API key for Coding (Llama 3.3 70B Instruct)
NVIDIA_CODING_API_KEY=your_nvidia_coding_api_key_here

# Nvidia NIM API key for Control & Device Automation (Nemotron Ultra 550B)
NVIDIA_AUTOMATION_API_KEY=your_nvidia_automation_api_key_here

# ------------------------------------------------------------------------------
# 2. Obsidian Vault Settings (Local Memory Layer)
# ------------------------------------------------------------------------------
# Path to your local Obsidian markdown vault
OBSIDIAN_VAULT_PATH=d:\JON\vault

# Local REST API plugin settings (Optional if using direct filesystem access)
OBSIDIAN_REST_API_URL=http://127.0.0.1:27124
OBSIDIAN_REST_API_KEY=your_obsidian_api_key_here

# ------------------------------------------------------------------------------
# 3. System Behavior & Guardrails
# ------------------------------------------------------------------------------
# Require user confirmation before executing potentially destructive tools
REQUIRE_TOOL_CONFIRMATION=true

# Default I/O Modes: "text" or "voice"
DEFAULT_INPUT_SOURCE=text
DEFAULT_OUTPUT_MODE=text
